[Unit]
Description=Release and retire HIDloom early-initramfs input chain
Documentation=file://@HIDLOOM_REPO_ROOT@/docs/ops/rpi-os-early-initramfs-experiment.md
DefaultDependencies=no
After=tmp.mount
Before=hidloom-usb-gadget.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
ExecStart=/usr/bin/python3 -S @HIDLOOM_REPO_ROOT@/tools/rpi_os_early_input_handoff.py prepare
