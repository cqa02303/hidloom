[Unit]
Description=Keyboard Matrix Scanner Daemon (matrixd)
Documentation=file://@HIDLOOM_REPO_ROOT@/daemon/matrixd/README.md
After=hidloom-logicd-core.service
Requires=hidloom-logicd-core.service
Requires=hidloom-early-input-handoff-prepare.service
After=hidloom-early-input-handoff-prepare.service
Wants=hidloom-early-input-handoff-finalize.service

[Service]
Type=simple
ExecStart=@HIDLOOM_REPO_ROOT@/daemon/matrixd/matrixd @HIDLOOM_REPO_ROOT@/config/default/matrixd.json
WorkingDirectory=@HIDLOOM_REPO_ROOT@
User=root
Group=root
Environment=MATRIXD_STATUS_PATH=/run/hidloom/matrixd-status.json
Environment=MATRIXD_EVENT_LOG_PATH=/run/hidloom/matrixd-trace.jsonl
Environment=MATRIXD_EVENT_LOG_MAX_BYTES=4194304
RuntimeDirectory=hidloom
RuntimeDirectoryPreserve=yes

Nice=-20
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=99
IOSchedulingClass=realtime
IOSchedulingPriority=0
LimitRTPRIO=99
LimitNICE=-20

Restart=on-failure
RestartSec=2s

TimeoutStopSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=matrixd

[Install]
WantedBy=multi-user.target
